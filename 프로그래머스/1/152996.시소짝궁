import java.util.*;

//가능한 비율 2:3 3:4 1:2 
class Solution {
    public long solution(int[] weights) {
        Map<Integer,Long> map = new HashMap<>();
        long ans=0;
       //1. 같은 몸무게 
        for(int i=0;i<weights.length;i++){
            map.put(weights[i],map.getOrDefault(weights[i],0L)+1);
        }
       // 같은 값일 때 정답은 *개중 2개 선택 경우의 수 
        for(int key : map.keySet()){
            if(map.get(key)>=2){
                ans+= (map.get(key)*(map.get(key)-1)/2);
            }
        }
       
        
      //2. 다른 몸무게 map : 100 180 360 270             
        // 180: 270 = 2: 3  270*2/3 = 180 
        // 100 200 = 1: 2 200*1/2
      for(int w : map.keySet()){
          // 갯수 
          long count = map.get(w);

            // 2:3
            if ((w * 2) % 3 == 0) {
                int target = w * 2 / 3;
                if (map.containsKey(target)) {
                    ans += count * map.get(target);
                }
            }

            // 1:2
            if (map.containsKey(w * 2)) {
                ans += count * map.get(w * 2);
            }

            // 3:4
            if ((w * 3) % 4 == 0) {
                int target = w * 3 / 4;
                if (map.containsKey(target)) {
                    ans += count * map.get(target);
                }
            }
        }

        return ans;
      }
     
}
